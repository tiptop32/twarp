<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.twarp.singbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/sing-box/bin/sing-box</string>
    <string>run</string>
    <string>-c</string>
    <string>/usr/local/etc/twarp/config.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/twarp</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/twarp/sing-box.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/twarp/sing-box.log</string>
</dict>
</plist>
