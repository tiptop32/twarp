<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.twarp.geo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/twarp</string>
    <string>geo</string>
    <string>update</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TWARP_OUT</key>
    <string>/usr/local/etc/twarp</string>
  </dict>
  <key>StartInterval</key>
  <integer>86400</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/twarp/geo-update.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/twarp/geo-update.err.log</string>
</dict>
</plist>
