<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.twarp.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/twarp</string>
    <string>daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TWARP_OUT</key>
    <string>/usr/local/etc/twarp</string>
    <key>TWARP_OWNER_UID</key>
    <string>501</string>
    <key>TWARP_OWNER_GID</key>
    <string>20</string>
    <key>TWARP_OWNER_USER</key>
    <string>alice</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/twarp</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/twarp/twarpd.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/twarp/twarpd.log</string>
</dict>
</plist>
